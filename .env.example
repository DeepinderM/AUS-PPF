# Where trade access requests (Trade supply page) are forwarded, e.g. a GoHighLevel
# inbound webhook URL. Required for that form to work. Set it in .env.local for dev
# and in Vercel for production.
TRADE_WEBHOOK_URL=

# Where general contact enquiries (Contact page) are forwarded. Can be the same
# webhook as above, or a different one if you want the two kept apart.
CONTACT_WEBHOOK_URL=

# Public URL of the live site, used for canonical/Open Graph URLs and the sitemap.
# On Vercel this falls back to the production domain automatically if left blank.
NEXT_PUBLIC_SITE_URL=https://www.ausppf.com.au
